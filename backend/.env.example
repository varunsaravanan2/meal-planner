# Copy this file to .env and fill in your own values. Never commit .env to git.

# PostgreSQL — update user/password to match your local Docker setup
DATABASE_URL=postgresql://user:password@localhost:5433/meal_planner

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Get your key at: https://console.anthropic.com (requires billing, pay per use)
ANTHROPIC_API_KEY=sk-ant-...

# Free key — sign up at: https://fdc.nal.usda.gov/api-key-signup (just an email, no card)
# DEMO_KEY works for local dev but has a lower rate limit
USDA_API_KEY=DEMO_KEY

ALLOWED_ORIGINS=["http://localhost:3000"]